#!/usr/bin/env bash
# Wrapper: runs kpt.py in the skill's private Python 3.12 venv (rapidocr/onnxruntime lack wheels for newer Pythons).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$DIR/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  UV="$(command -v uv || true)"
  if [ -z "$UV" ]; then python3 -m pip install --user -q uv >&2; UV="$HOME/.local/bin/uv"; fi
  "$UV" venv -q -p 3.12 "$VENV" >&2
  VIRTUAL_ENV="$VENV" "$UV" pip install -q rapidocr onnxruntime pymupdf opencv-python-headless pillow numpy >&2
fi
exec "$VENV/bin/python" "$DIR/kpt.py" "$@"
